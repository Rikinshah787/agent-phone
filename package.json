    "agent-phone": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rikinshah787/agent-phone.git"
  },
  "homepage": "https://github.com/Rikinshah787/agent-phone#readme",
  "bugs": "https://github.com/Rikinshah787/agent-phone/issues",
  "engines": {
    "node": ">=20.15"
  },
  "keywords": [
    "mcp",
    "android",
    "emulator",
    "ai-agent",
    "claude",
    "mobile-testing",
